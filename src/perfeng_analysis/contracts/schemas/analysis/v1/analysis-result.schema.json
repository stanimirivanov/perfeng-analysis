{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/analysis/v1/analysis-result.schema.json",
  "title": "Independent quality, requirement, and regression outcomes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contractsVersion",
    "runId",
    "testId",
    "createdAt",
    "producer",
    "policy",
    "candidateArtifact",
    "referenceArtifacts",
    "blocking",
    "evaluations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "AnalysisResult"
    },
    "contractsVersion": {
      "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
    },
    "runId": {
      "$ref": "https://perfeng.dev/schemas/result/v1/test-result.schema.json#/properties/runId"
    },
    "testId": {
      "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
    },
    "createdAt": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/$defs/timestamp"
    },
    "producer": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/producer"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "mode"
      ],
      "properties": {
        "id": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
        },
        "sha256": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/sha256"
        },
        "mode": {
          "enum": [
            "observe",
            "inform"
          ]
        }
      }
    },
    "candidateArtifact": {
      "allOf": [
        {
          "$ref": "https://perfeng.dev/schemas/artifact/v1/artifact-reference.schema.json"
        },
        {
          "properties": {
            "kind": {
              "const": "normalized"
            },
            "mediaType": {
              "const": "application/json"
            },
            "format": {
              "const": "normalized-result/v1"
            }
          }
        }
      ]
    },
    "referenceArtifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "https://perfeng.dev/schemas/artifact/v1/artifact-reference.schema.json"
          },
          {
            "properties": {
              "kind": {
                "const": "normalized"
              },
              "mediaType": {
                "const": "application/json"
              },
              "format": {
                "const": "normalized-result/v1"
              }
            }
          }
        ]
      }
    },
    "blocking": {
      "type": "boolean",
      "const": false
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "metric",
          "quality",
          "slo",
          "regression"
        ],
        "properties": {
          "ruleId": {
            "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
          },
          "metric": {
            "$ref": "https://perfeng.dev/schemas/policy/v1/performance-policy.schema.json#/$defs/metricSelector"
          },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "INVALID",
                  "UNSTABLE",
                  "INCONCLUSIVE",
                  "NOT_EVALUATED"
                ]
              },
              "reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "samples": {
                "type": "integer",
                "minimum": 1
              },
              "cv": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "slo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE",
                  "NOT_EVALUATED"
                ]
              },
              "reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          },
          "regression": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reasons"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE",
                  "NOT_EVALUATED"
                ]
              },
              "reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "candidateValue": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "referenceValue": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "referenceArtifactId": {
                "type": "string",
                "format": "uuid"
              },
              "effect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "relative",
                      "absolute"
                    ]
                  },
                  "value": {
                    "type": "number"
                  }
                }
              },
              "method": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "version": {
                    "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "candidateValue",
                    "referenceValue",
                    "referenceArtifactId",
                    "effect",
                    "method"
                  ],
                  "properties": {
                    "candidateValue": {
                      "type": "number"
                    },
                    "referenceValue": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
