{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/catalogue/v1/test-catalogue.schema.json",
  "title": "Versioned performance test catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "tests"
  ],
  "properties": {
    "apiVersion": {
      "const": "performance.perfeng.io/v1"
    },
    "kind": {
      "const": "TestCatalogue"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "criticality",
          "tool",
          "source",
          "artifact",
          "workloads"
        ],
        "properties": {
          "id": {
            "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "enum": [
                  "k6",
                  "playwright"
                ]
              },
              "version": {
                "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/version"
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "gitSha",
              "entrypoint"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "gitSha": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{40}$"
              },
              "entrypoint": {
                "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json#/$defs/relativePath"
              }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
              }
            }
          },
          "workloads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://perfeng.dev/schemas/workload/v1/workload.schema.json"
            }
          },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "pr": {
                "enum": [
                  "smoke",
                  "average",
                  "regression",
                  "stress",
                  "capacity",
                  "soak"
                ]
              },
              "main": {
                "enum": [
                  "smoke",
                  "average",
                  "regression",
                  "stress",
                  "capacity",
                  "soak"
                ]
              },
              "nightly": {
                "enum": [
                  "smoke",
                  "average",
                  "regression",
                  "stress",
                  "capacity",
                  "soak"
                ]
              },
              "scheduled": {
                "enum": [
                  "smoke",
                  "average",
                  "regression",
                  "stress",
                  "capacity",
                  "soak"
                ]
              },
              "release": {
                "enum": [
                  "smoke",
                  "average",
                  "regression",
                  "stress",
                  "capacity",
                  "soak"
                ]
              }
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://perfeng.dev/schemas/result/v1/test-result.schema.json#/properties/metric"
            }
          }
        }
      }
    }
  }
}
