{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/normalized-result/v1/normalized-result.schema.json",
  "title": "Normalized multi-metric result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contractsVersion",
    "runId",
    "testId",
    "workload",
    "producer",
    "measurementWindow",
    "createdAt",
    "sourceArtifacts",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "NormalizedResult"
    },
    "contractsVersion": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/contractsVersion"
    },
    "runId": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/runId"
    },
    "testId": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/testId"
    },
    "workload": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/workload"
    },
    "producer": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/producer"
    },
    "measurementWindow": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/measurementWindow"
    },
    "createdAt": {
      "$ref": "https://perfeng.dev/schemas/raw-result/v1/raw-result.schema.json#/properties/createdAt"
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "https://perfeng.dev/schemas/artifact/v1/artifact-reference.schema.json"
          },
          {
            "properties": {
              "kind": {
                "const": "raw"
              }
            }
          }
        ]
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://perfeng.dev/schemas/result/v2/test-result.schema.json"
      }
    }
  }
}
